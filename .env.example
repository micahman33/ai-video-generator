# Create a key at https://console.higgsfield.ai (API keys section).
# Paste it as KEY_ID:KEY_SECRET
HF_CREDENTIALS=

# Or as two separate values instead:
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# Port for the local UI (the server only listens on 127.0.0.1)
PORT=5173

# Set to 1 to fake every Higgsfield call (no credits spent) while trying out the UI
HF_MOCK=0
